{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2021", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["./**/*.ts"],
	"exclude": ["_generated"]
}
