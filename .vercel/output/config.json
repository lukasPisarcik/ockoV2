{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/game/?(?:/__data.json)?$",
			"dest": "/game"
		},
		{
			"src": "^/history/?(?:/__data.json)?$",
			"dest": "/history"
		},
		{
			"src": "^/stats/?(?:/__data.json)?$",
			"dest": "/stats"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}